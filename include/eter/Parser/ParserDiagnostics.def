/// \file
/// Parser diagnostic IDs and their static message templates.
///
/// Uses the X-Macro pattern to generate the `parser::DiagID` enum and its
/// `messageFor` lookup without duplicating the list. Templates may contain
/// `{name}` placeholders resolved at emission time via
/// `diag::renderMessage` against the `Args` carried in `PhaseDiagnostic`.
/// To use this file, define `ETER_PARSE_DIAG(ID, Template)` before
/// including it.

#ifndef ETER_PARSE_DIAG
#define ETER_PARSE_DIAG(X, Y)
#endif

ETER_PARSE_DIAG(ExpectedTopLevelDecl,    "expected a top-level declaration")
ETER_PARSE_DIAG(ExpectedFnKeyword,       "expected 'fn'")
ETER_PARSE_DIAG(ExpectedFnName,          "expected function name")
ETER_PARSE_DIAG(ExpectedParamListOpen,   "expected '(' to start parameter list")
ETER_PARSE_DIAG(ExpectedParamListClose,  "expected ')' to close parameter list")
ETER_PARSE_DIAG(ExpectedParamName,       "expected parameter name")
ETER_PARSE_DIAG(ExpectedParamColon,      "expected ':' after parameter name")
ETER_PARSE_DIAG(ExpectedTypeName,        "expected type name")
ETER_PARSE_DIAG(ExpectedTupleTypeClose,  "expected ')' to close tuple type")
ETER_PARSE_DIAG(ExpectedTupleExprClose,  "expected ')' to close tuple expression")
ETER_PARSE_DIAG(ExpectedPathSegment,     "expected identifier after '::'")
ETER_PARSE_DIAG(RedundantPathSeparator,  "redundant '::' in path")
ETER_PARSE_DIAG(ExpectedArrayTypeSemi,   "expected ';' in array type")
ETER_PARSE_DIAG(ExpectedArrayTypeClose,  "expected ']' to close array type")
ETER_PARSE_DIAG(ExpectedArrayLitClose,   "expected ']' to close array literal")
ETER_PARSE_DIAG(ExpectedTensorOpen,      "expected '[' after 'tensor'")
ETER_PARSE_DIAG(ExpectedTensorTypeSemi,  "expected ';' in tensor type")
ETER_PARSE_DIAG(ExpectedTensorSize,      "expected tensor dimension after ';'")
ETER_PARSE_DIAG(ExpectedTensorTypeClose, "expected ']' to close tensor type")
ETER_PARSE_DIAG(ExpectedTensorIndexClose, "expected ']' to close tensor index expression")
ETER_PARSE_DIAG(ExpectedTensorLitSemi,   "expected ';' separating values from shape in tensor literal")
ETER_PARSE_DIAG(ExpectedTensorLitDim,    "expected at least one dimension after ';' in tensor literal")
ETER_PARSE_DIAG(ExpectedTensorLitClose,  "expected ']' to close tensor literal")
ETER_PARSE_DIAG(ExpectedStructKeyword,   "expected 'struct'")
ETER_PARSE_DIAG(ExpectedStructName,      "expected struct name")
ETER_PARSE_DIAG(ExpectedStructOpen,      "expected '{' to start struct body")
ETER_PARSE_DIAG(ExpectedStructClose,     "expected '}' to close struct body")
ETER_PARSE_DIAG(ExpectedStructFieldName, "expected field name")
ETER_PARSE_DIAG(ExpectedStructFieldColon, "expected ':' after field name")
ETER_PARSE_DIAG(ExpectedEnumKeyword,     "expected 'enum'")
ETER_PARSE_DIAG(ExpectedEnumName,        "expected enum name")
ETER_PARSE_DIAG(ExpectedEnumOpen,        "expected '{' to start enum body")
ETER_PARSE_DIAG(ExpectedEnumClose,       "expected '}' to close enum body")
ETER_PARSE_DIAG(ExpectedEnumVariantName, "expected enum variant name")
ETER_PARSE_DIAG(ExpectedVariantTupleClose, "expected ')' to close tuple variant")
ETER_PARSE_DIAG(ExpectedVariantStructClose, "expected '}' to close struct variant")
ETER_PARSE_DIAG(ExpectedUnionKeyword,    "expected 'union'")
ETER_PARSE_DIAG(ExpectedUnionName,       "expected union name")
ETER_PARSE_DIAG(ExpectedUnionOpen,       "expected '{' to start union body")
ETER_PARSE_DIAG(ExpectedUnionClose,      "expected '}' to close union body")
ETER_PARSE_DIAG(ExpectedModKeyword,      "expected 'mod'")
ETER_PARSE_DIAG(ExpectedModName,         "expected module name after 'mod'")
ETER_PARSE_DIAG(ExpectedModClose,        "expected '}' to close module body")
ETER_PARSE_DIAG(ExpectedModOpenOrSemi,   "expected '{' or ';' after module name")
ETER_PARSE_DIAG(ExpectedConstKeyword,    "expected 'const'")
ETER_PARSE_DIAG(ExpectedConstName,       "expected constant name")
ETER_PARSE_DIAG(ExpectedConstColon,      "expected ':' after constant name")
ETER_PARSE_DIAG(ExpectedConstEquals,     "expected '=' in constant declaration")
ETER_PARSE_DIAG(ExpectedConstSemi,       "expected ';' to terminate constant declaration")
ETER_PARSE_DIAG(ExpectedConstLiteral,    "expected literal expression in const expression")
ETER_PARSE_DIAG(ExpectedParenExprClose,  "expected ')' to close parenthesized expression")
ETER_PARSE_DIAG(ExpectedBlockOpen,       "expected '{'")
ETER_PARSE_DIAG(ExpectedBlockClose,      "expected '}' to close block")
ETER_PARSE_DIAG(ExpectedSemiAfterExpr,   "expected ';' after expression")
ETER_PARSE_DIAG(ExpectedStmt,            "expected statement")
ETER_PARSE_DIAG(ExpectedLetKeyword,      "expected 'let'")
ETER_PARSE_DIAG(ExpectedRetKeyword,      "expected 'ret'")
ETER_PARSE_DIAG(ExpectedLetName,         "expected name after regime")
ETER_PARSE_DIAG(ExpectedColonAfterName,  "expected ':' after name")
ETER_PARSE_DIAG(ExpectedEqAfterType,     "expected '=' after type")
ETER_PARSE_DIAG(ExpectedLetSemi,         "expected ';' after let statement")
ETER_PARSE_DIAG(ExpectedExpr,            "expected expression")
ETER_PARSE_DIAG(ExpectedArgListOpen,     "expected '(' to start argument list")
ETER_PARSE_DIAG(ExpectedArgListClose,    "expected ')' to close argument list")
ETER_PARSE_DIAG(ExpectedRSquare,         "expected ']' to close index expression")
ETER_PARSE_DIAG(ExpectedFieldName,       "expected field name after '.'")
ETER_PARSE_DIAG(ExpectedFieldInitName,   "expected field name in struct literal")
ETER_PARSE_DIAG(ExpectedStructLitClose,  "expected '}' to close struct literal")
ETER_PARSE_DIAG(ExpectedIfKeyword,       "expected 'if'")
ETER_PARSE_DIAG(ExpectedWhileKeyword,    "expected 'while'")

ETER_PARSE_DIAG(ExpectedMatchKeyword,    "expected 'match'")
ETER_PARSE_DIAG(ExpectedFatArrow,        "expected '=>' after pattern")
ETER_PARSE_DIAG(ExpectedMatchArm,        "expected match arm")
ETER_PARSE_DIAG(ExpectedPattern,         "expected pattern")
ETER_PARSE_DIAG(ExpectedTuplePatClose,   "expected ')' to close tuple pattern")
ETER_PARSE_DIAG(ExpectedStructPatClose,  "expected '}' to close struct pattern")
ETER_PARSE_DIAG(ExpectedFieldPatName,    "expected field name in struct pattern")

#undef ETER_PARSE_DIAG
